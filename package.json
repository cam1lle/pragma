{
  "name": "pragma",
  "version": "0.1.0",
  "description": "Agent mission registry and coordination platform",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.2.0",
    "fastify-cors": "6.1.0",
    "fastify-plugin": "^3.0.1",
    "pdfkit": "^0.19.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
